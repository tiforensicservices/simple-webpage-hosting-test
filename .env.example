# =============================================================
# Environment Variables Template
# COPY this file to .env and fill in your values
# NEVER commit .env — it is in .gitignore
# =============================================================

# AWS Credentials (from IAM user — programmatic access)
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1

# S3 Configuration
S3_BUCKET_NAME=shoeprint-images-YOUR_ACCOUNT_ID
S3_RAW_PREFIX=raw/
S3_PROCESSED_PREFIX=processed/
S3_THUMBNAILS_PREFIX=thumbnails/

# Database (RDS PostgreSQL — fill in after RDS is created)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=shoeprint_db
DB_USER=admin
DB_PASSWORD=your_secure_password_here

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
APP_SECRET_KEY=generate_a_random_secret_key_here

# AWS Rekognition (optional — for image analysis)
REKOGNITION_COLLECTION_ID=shoeprint-collection
