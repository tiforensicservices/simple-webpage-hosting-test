# =============================================================
# Environment Variables Template — Gaitway Footwear Intelligence Database
# COPY this file to .env and fill in your values
# NEVER commit .env — it is in .gitignore
# =============================================================

# ──────────────────────────────────────────────────────────────
# AWS Credentials (from IAM user — programmatic access only)
# ──────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_DEFAULT_REGION=us-east-2
AWS_ACCOUNT_ID=791209948637

# ──────────────────────────────────────────────────────────────
# S3 Configuration
# ──────────────────────────────────────────────────────────────
S3_BUCKET_NAME=gaitway-footwear-YOUR_ACCOUNT_ID
S3_RAW_PREFIX=raw/
S3_PROCESSED_PREFIX=processed/
S3_IMPRESSIONS_PREFIX=impressions/
S3_THUMBNAILS_PREFIX=thumbnails/
S3_CRIME_SCENE_PREFIX=crime-scene/
S3_USER_SHOES_PREFIX=user-shoes/

# ──────────────────────────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# Local dev (docker compose):  localhost / gaitway / gaitway_local
# Production (RDS):            your-rds-endpoint.rds.amazonaws.com
# ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gaitway
DB_USER=gaitway
DB_PASSWORD=gaitway_local
# Set to "true" to log all SQL queries (dev only — never in prod)
DB_ECHO=false

# ──────────────────────────────────────────────────────────────
# Stripe Billing
# ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
STRIPE_PRICE_ID_YEARLY=your_yearly_price_id_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRODUCT_ID=prod_TtcDNkZohuUdvB

# ──────────────────────────────────────────────────────────────
# AWS Cognito (Auth)
# ──────────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-east-2_your_pool_id
COGNITO_CLIENT_ID=your_cognito_client_id_here
COGNITO_REGION=us-east-2

# ──────────────────────────────────────────────────────────────
# Application Settings
# ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
APP_SECRET_KEY=generate_a_random_secret_key_here

# API key for third-party services (do NOT commit real keys)
# Example: API_KEY=sk_test_...
API_KEY=replace_with_your_api_key_here

# ──────────────────────────────────────────────────────────────
# Scraper Settings
# ──────────────────────────────────────────────────────────────
SCRAPER_RATE_LIMIT_SECONDS=2
SCRAPER_MAX_RETRIES=3
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; GaitwayBot/1.0)
